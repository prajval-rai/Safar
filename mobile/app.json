{
  "expo": {
    "name": "Safar",
    "slug": "safar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "safar",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.safar.app"
    },
    "android": {
      "package": "in.safar.app",
      "adaptiveIcon": {
        "backgroundColor": "#e2761b",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#fff8f0"
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Safar checks your distance from a stop so a check-in can only be marked from within 1 km of the real place."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.58397693974-e5t1a0aq78fel7sg2afvu6o3vk2gbi0c"
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Safar lets you add photos from your trips to the trip's shared album.",
          "cameraPermission": "Safar lets you take a photo for your trip's shared album."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "22258a1c-7fc2-48d8-8898-e4e1867c135d"
      },
      "googleIosClientId": "58397693974-e5t1a0aq78fel7sg2afvu6o3vk2gbi0c.apps.googleusercontent.com"
    },
    "owner": "prajval2001"
  }
}
